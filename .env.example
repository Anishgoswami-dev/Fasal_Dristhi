# CropSentinel — SIH 2026 PS-26131
# Copy this file to .env and fill in your values. Never commit .env.

# ── App Mode ──────────────────────────────────────────────────────
APP_MODE=development        # development | production

# ── MongoDB Atlas ─────────────────────────────────────────────────
MONGODB_URI=your_mongodb_atlas_connection_string

# ── Cloudinary ────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Express Server ─────────────────────────────────────────────────
PORT=4000

# ── AI Inference Microservice (Python FastAPI) ────────────────────
AI_SERVICE_URL=http://localhost:8000

# ── Weather API (OpenWeatherMap) ──────────────────────────────────
WEATHER_API_KEY=your_openweathermap_api_key
WEATHER_CACHE_TTL_MINUTES=10

# ── AI Confidence Thresholds ──────────────────────────────────────
AI_HIGH_CONFIDENCE=0.85
AI_MEDIUM_CONFIDENCE=0.60
